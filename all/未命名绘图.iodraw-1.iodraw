        <mxCell id="GHFu772-0MmhGUee8oSZ-1" value="表示层 · 微信小程序前端（WXML/WXSS/JavaScript）&#xa;──────────────────────────────&#xa;· WXML —— 页面结构　· WXSS —— 页面样式　· JavaScript —— 业务逻辑&#xa;· 微信开发者工具：界面开发与调试&#xa;· 平台能力：微信登录（wx.login 换 openid）、消息通知" style="whiteSpace=wrap;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="260" height="278" as="geometry" />
        </mxCell>
        <mxCell id="GHFu772-0MmhGUee8oSZ-2" value="HTTPS 接口 · 前后端分离（B/S 架构）" style="whiteSpace=wrap;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="33" y="348" width="234" height="67" as="geometry" />
        </mxCell>
        <mxCell id="GHFu772-0MmhGUee8oSZ-3" value="业务逻辑层 · Spring Boot 后端&#xa;──────────────────────────────&#xa;· RESTful 接口（@RestController，如 /api/order、/api/user）&#xa;· 业务逻辑处理（Service 层）&#xa;· 数据持久化（MyBatis Mapper + XML）" style="whiteSpace=wrap;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="22" y="464" width="255" height="225" as="geometry" />
        </mxCell>
        <mxCell id="GHFu772-0MmhGUee8oSZ-4" value="数据访问层 · MyBatis（Mapper / 数据持久化）" style="whiteSpace=wrap;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="51" y="739" width="197" height="84" as="geometry" />
        </mxCell>
        <mxCell id="GHFu772-0MmhGUee8oSZ-5" value="数据层 · MySQL 数据库&#xa;──────────────────────────────&#xa;· 规范化数据表：user（用户）/ delivery（配送员）/ order（订单）/ building（楼栋）/ comment（评价）&#xa;· 主外键约束 —— 保证数据完整性&#xa;· 索引 —— 提升查询性能　· 事务 —— 保障数据一致性" style="whiteSpace=wrap;strokeWidth=2;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" vertex="1" parent="1">
          <mxGeometry x="23" y="874" width="254" height="260" as="geometry" />
        </mxCell>
        <mxCell id="GHFu772-0MmhGUee8oSZ-6" value="技术路线小结：&#xa;微信小程序前端 + Spring Boot 后端 + MySQL，通过 HTTPS 接口通信，构成「表示层 → 业务逻辑层 → 数据访问层」三层结构；整体采用 B/S 架构、前后端分离。" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
